      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@markup-carve/carve": "^0.1.13",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@markup-carve/carve-grammars": "^0.1.19",
    "shiki": "^4.0.0",
    "vitest": "^2.1.8"
