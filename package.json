{
  "name": "@markup-carve/eleventy-carve",
  "version": "0.1.4",
  "description": "Eleventy (11ty) plugin that adds the Carve markup language as a first-class template format (.crv), rendered to HTML via carve-js.",
  "type": "module",
  "license": "MIT",
  "author": "Mark Scherer",
  "repository": {
    "type": "git",
    "url": "https://github.com/markup-carve/eleventy-carve"
  },
  "keywords": [
    "eleventy",
    "eleventy-plugin",
    "11ty",
    "carve",
    "markup",
    "djot"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=3.0.0",
    "@markup-carve/carve-grammars": "^0.1.19",
